<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_purchase_order_payment_request_inherit" model="ir.ui.view">
        <field name="name">purchase.order.payment.request.inherit</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='currency_id']" position="after">
                <field name="advance_percentage"/>
            </xpath>

            <xpath expr="//sheet//div[@name='button_box']" position="inside">
                <button name="action_open_payment_requests"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-money"
                        attrs="{'invisible': [('payment_request_count', '=', 0)]}">
                    <field name="payment_request_count"
                           widget="statinfo"
                           string="Payment Requests"/>
                </button>
            </xpath>

        </field>
    </record>

</odoo>
